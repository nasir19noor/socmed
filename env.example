# Tambahkan baris-baris ini ke ~/.openclaw/.env  (jangan dibagikan ke siapa pun)

# Nomor WhatsApp pemilik akun (penerima usulan & satu-satunya yang boleh menyetujui),
# format internasional. Dipakai pasang.sh dan cron-setup.sh; tidak disimpan di repo.
THREADS_PEMILIK=+62

# Threads API (Meta for Developers -> aplikasi Threads) — akun "utama" (@nasir19noor: 3 posting terjadwal/hari)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_HANDLE=@namaakunanda

# Jadwal & tema tiap akun ada di skrip (antrian.JADWAL / TEMA); THREADS_AKUN_JADWAL tidak dipakai lagi.
# Laporan mingguan (jalankan laporan) butuh izin token threads_manage_insights untuk setiap akun.

# Akun "bisnis" (@lantip.ai.id: 7 posting terjadwal/hari). Akun lain bisa ditambah dengan pola yang sama
# dan diposting sesuai permintaan ("threads @nama ...").
# Nama akun = akhiran setelah garis bawah, huruf kecil/angka, mis. _BISNIS -> akun "bisnis".
# Tiap akun butuh token sendiri (aplikasi Meta yang sama; tambahkan akunnya sebagai Threads Tester).
# THREADS_USER_ID_BISNIS=
# THREADS_ACCESS_TOKEN_BISNIS=
# THREADS_HANDLE_BISNIS=@akunbisnis

# Virtual environment Python (opsional, default sudah ini)
KONTEN_VENV=/home/openclaw/projects/threads/venv

# Hosting gambar agar bisa diambil Threads (gratis: https://api.imgbb.com)
IMGBB_API_KEY=
